# Li-SNAP OpenKIM model validation
# LAMMPS input: BCC Lithium 2x2x2 with pair_style kim
# Model: SNAP_ZuoChenLi_2019_Li__MO_732106099012_000

units           metal
dimension       3
boundary        p p p
atom_style      atomic

# --- BCC Li 2x2x2 supercell ---
lattice         bcc 3.51
region          box block 0 2 0 2 0 2
create_box      1 box
create_atoms    1 box

mass            1 6.941

neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes

# --- OpenKIM Li-SNAP model ---
pair_style      kim SNAP_ZuoChenLi_2019_Li__MO_732106099012_000
pair_coeff      * * Li

# --- Thermodynamic output ---
thermo          10
thermo_style    custom step temp pe ke etotal press lx ly lz vol

# --- Energy minimization ---
minimize        1.0e-12 1.0e-12 10000 100000

# --- Variables for final report ---
variable        mype equal pe
variable        mypress equal press
variable        mylx equal lx
variable        a_lat equal lx/2

# --- Final report ---
print ""
print "================================================"
print "  Li-SNAP OpenKIM validation complete"
print "================================================"
print "Total Energy         = ${mype} eV"
print "Pressure             = ${mypress} bar"
print "Box length (x)       = ${mylx} Angstroms (2 cells)"
print "Lattice const        = ${a_lat} Angstroms/cell"
print "================================================"
print ""

write_data       final.data