# Phase-1 Step 5: quench 363 K -> 10 K at 10 K/ps under true zero-pressure iso NPT
# 35300 steps x 0.001 ps = 35.3 ps, dT/dt = 0.01 K/step (same as validated v1/v3 runs)
# Usage: lmp -in in.p1_quench -var kim_model ...
units           metal
atom_style      atomic
boundary        p p p
read_restart    phase1/p1_annealed.restart
pair_style      kim ${kim_model}
pair_coeff      * * Li
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

timestep        0.001
reset_timestep  0

fix             1 all npt temp 363.0 10.0 0.1 iso 0.0 0.0 1.0

thermo          500
thermo_style    custom step temp pe etotal pxx pyy pzz press vol lx ly lz

restart         5000 phase1/p1_quench.checkpoint.*

dump            1 all custom 1000 phase1/p1_quench.dump id type x y z
dump_modify     1 sort id

run             35300

unfix           1
undump          1

write_data      phase1/p1_quenched.data
write_restart   phase1/p1_quenched.restart
print           "P1_QUENCH finalT=$(temp) Pxx=$(pxx) Pyy=$(pyy) Pzz=$(pzz)"
print           "P1_QUENCH_DONE"
