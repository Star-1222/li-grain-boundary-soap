# v2 Sigma5 (310)[001] BCC Li -- stage 2: NVT anneal 300 K, 20 ps
# Continues from stage 1 restart (true restart-based continuation).
# Usage: lmp -in in.2_anneal -var outdir ../outputs -var seed 12345 \
#            -var kim_model SNAP_ZuoChenLi_2019_Li__MO_732106099012_000
units metal
atom_style atomic
boundary p p p
read_restart ${outdir}/stage1_minimized.restart
read_restart outputs/stage1_minimized.restart
Reading restart file ...
  restart file = 10 Dec 2025, LAMMPS = 10 Dec 2025
  restoring atom style atomic from restart
  orthogonal box = (0.28932551 0 0) to (66.235885 33.262605 35.061865)
  3 by 2 by 2 MPI processor grid
  pair style kim stores no restart info
  3600 atoms
  read_restart CPU = 0.005 seconds
pair_style kim ${kim_model}
pair_style kim SNAP_ZuoChenLi_2019_Li__MO_732106099012_000
pair_coeff * * Li
timestep 0.001
reset_timestep 0
velocity all create 300.0 ${seed} dist gaussian
velocity all create 300.0 12345 dist gaussian
fix 1 all nvt temp 300.0 300.0 0.1
thermo 500
thermo_style custom step temp pe ke etotal press pxx pyy pzz pxy pxz pyz
dump 1 all custom 500 ${outdir}/stage2_anneal.dump id type x y z vx vy vz
dump 1 all custom 500 outputs/stage2_anneal.dump id type x y z vx vy vz
# checkpoint every 1000 steps (1 ps); timestep is appended automatically
restart 1000 ${outdir}/stage2_anneal.checkpoint
restart 1000 outputs/stage2_anneal.checkpoint
run 20000

