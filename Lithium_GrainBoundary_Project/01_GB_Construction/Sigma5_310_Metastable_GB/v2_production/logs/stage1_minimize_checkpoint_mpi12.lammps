# v2 Sigma5 (310)[001] BCC Li -- stage 1: initial energy minimization
# Usage: lmp -in in.1_minimize -var outdir ../outputs -var kim_model SNAP_ZuoChenLi_2019_Li__MO_732106099012_000
units metal
atom_style atomic
boundary p p p
read_data ${input_data}
read_data outputs/Sigma5_310.data
Reading data file ...
  orthogonal box = (0 0 0) to (66.525211 33.262605 35.061865)
  3 by 2 by 2 MPI processor grid
  reading atoms ...
  3600 atoms
  reading velocities ...
  3600 velocities
  read_data CPU = 0.023 seconds
pair_style kim ${kim_model}
pair_style kim SNAP_ZuoChenLi_2019_Li__MO_732106099012_000
pair_coeff * * Li
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
#
# ---- cell relaxation policy ----
# y, z (GB plane): FIXED at the zero-pressure bulk lattice/CSL periods.
# This preserves the intended in-plane bicrystal periodicity.
# x (GB normal): RELAXED at zero target pressure so the two periodic GBs
# can accommodate their excess volume without imposing normal stress.
fix 1 all box/relax x 0.0
min_style cg
thermo 100
thermo_style custom step pe etotal press pxx pyy pzz pxy pxz pyz lx ly lz
# Pre-anneal convergence with restartable 500-iteration chunks.
variable fmax_chunk equal fmax
variable fnorm_chunk equal fnorm
variable chunk loop 20

label stage1_chunk
minimize 0.0 1.0e-4 500 5000

