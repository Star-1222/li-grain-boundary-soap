# Current protocol: ANNEAL; input and outdir are supplied by run.py.
units           metal
atom_style      atomic
boundary        p p p
read_data     "${input}"
pair_style      kim ${kim_model}
pair_coeff      * * Li
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

timestep        0.001
reset_timestep  0

velocity        all create 363.0 ${seed} mom yes rot yes dist gaussian

fix             1 all npt temp 363.0 363.0 0.1 iso 0.0 0.0 1.0

thermo          250
thermo_style    custom step temp pe etotal pxx pyy pzz press vol lx ly lz

restart         5000 "${outdir}/checkpoint.*"

dump            1 all custom 1000 "${outdir}/trajectory.dump" id type x y z
dump_modify     1 sort id

run             25000

unfix           1
undump          1

write_data "${outdir}/final.data"
write_restart "${outdir}/final.restart"
print           "P1_ANNEAL finalT=$(temp) Pxx=$(pxx) Pyy=$(pyy) Pzz=$(pzz)"
print           "P1_ANNEAL_DONE"

print "CURRENT_ANNEAL_DONE"
