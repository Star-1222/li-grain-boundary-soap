# Li Sigma5 (310)[001] 2x2 -- stage 0 sanity check (potential + structure)
# Usage: lmp -in in.0_check -var outdir stage0_build_validate \
#            -var kim_model SNAP_ZuoChenLi_2019_Li__MO_732106099012_000
units metal
atom_style atomic
boundary p p p
read_data ${outdir}/Sigma5_310_K6_J6_L20.data
pair_style kim ${kim_model}
pair_coeff * * Li
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
thermo 1
thermo_style custom step atoms pe etotal press pxx pyy pzz pxy pxz pyz
run 0
print "STAGE0_CHECK_OK"
