LAMMPS (10 Dec 2025)
# Phase-1 Step 6: 10 K hold under true zero-pressure iso NPT (5 ps)
# Acceptance-critical: time-averaged P must be ~0 at 10 K.
# Usage: lmp -in in.p1_hold -var kim_model ...
units           metal
atom_style      atomic
boundary        p p p
read_restart    phase1/p1_quenched.restart
Reading restart file ...
  restart file = 10 Dec 2025, LAMMPS = 10 Dec 2025
  restoring atom style atomic from restart
  orthogonal box = (0.13550612 0.16890766 0.18917452) to (66.389705 66.356303 69.934555)
  2 by 2 by 3 MPI processor grid
  pair style kim stores no restart info
  14400 atoms
  read_restart CPU = 0.006 seconds
pair_style      kim ${kim_model}
pair_style      kim SNAP_ZuoChenLi_2019_Li__MO_732106099012_000
pair_coeff      * * Li
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

timestep        0.001
reset_timestep  0

fix             1 all npt temp 10.0 10.0 0.1 iso 0.0 0.0 1000.0

thermo          100
thermo_style    custom step temp pe etotal pxx pyy pzz press vol lx ly lz

restart         2500 phase1/p1_hold.checkpoint.*

dump            1 all custom 500 phase1/p1_hold.dump id type x y z
dump_modify     1 sort id

# running pressure averages for acceptance (windows every 2500 steps)
variable        vpxx  equal pxx
variable        vpyy  equal pyy
variable        vpzz  equal pzz
variable        vpress equal press
variable        vvol  equal vol
fix             2 all ave/time 100 25 2500 v_vpxx v_vpyy v_vpzz v_vpress v_vvol file phase1/p1_hold_pressure.stats

run             5000

